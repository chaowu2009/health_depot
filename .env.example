# Health Depot — environment variables.
# Copy to .env (make env) and adjust. Never commit .env.
# The same variables configure AWS later; only the values change.

# --- Django --------------------------------------------------------------------------
# Generate a long random value (make env does this for you).
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,demo.local,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=https://localhost,https://demo.local
SECURE_SSL_REDIRECT=true
# Idle session timeout (seconds). RFP-friendly default: 15 minutes.
SESSION_IDLE_TIMEOUT_SECONDS=900
DEMO_BANNER=true
LOG_LEVEL=INFO
# json (default, for CloudWatch later) or console (human-readable)
LOG_FORMAT=json

# --- Database (PostgreSQL 16 locally; Amazon RDS PostgreSQL later) ------------------
POSTGRES_DB=healthdepot
POSTGRES_USER=healthdepot
POSTGRES_PASSWORD=change-me-local-db-password
DATABASE_URL=postgres://healthdepot:change-me-local-db-password@db:5432/healthdepot

# --- File storage (S3 API: SeaweedFS locally; Amazon S3 later) -----------------------
AWS_STORAGE_BUCKET_NAME=health-depot-local
# Internal address the app uses. Leave EMPTY in AWS (the SDK picks the regional endpoint).
AWS_S3_ENDPOINT_URL=http://s3:8333
# Address browsers use for presigned URLs. Leave EMPTY in AWS.
AWS_S3_PUBLIC_ENDPOINT_URL=https://localhost:9443
# Any value works locally; in AWS set the real region (e.g., us-gov-west-1).
AWS_S3_REGION_NAME=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_PRESIGNED_EXPIRY_SECONDS=300
# Local-only keys (must match deploy/seaweedfs/s3.json). In AWS, REMOVE these two lines:
# the app gets credentials from its IAM role automatically.
AWS_ACCESS_KEY_ID=healthdepot-local
AWS_SECRET_ACCESS_KEY=healthdepot-local-secret-change-me
# Set true in AWS GovCloud to use FIPS 140 validated endpoints.
AWS_USE_FIPS_ENDPOINT=false
# Create the bucket on startup (local only). In AWS, infrastructure code creates it.
S3_CREATE_BUCKET=true

# --- Email (SMTP: Mailpit locally; Amazon SES SMTP later) ----------------------------
# Email backend: SMTP (default) or django.core.mail.backends.console.EmailBackend (log only)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Health Depot <no-reply@healthdepot.local>

# Optional: keep tables in their own schema when the host locks down "public" (blank = public)
DATABASE_SCHEMA=
# Check file storage during the migrate step (false = skip, e.g. hosted demo without storage keys)
S3_CHECK_BUCKET=true

# --- Web server ------------------------------------------------------------------------
GUNICORN_WORKERS=2
# Port the web server listens on (DigitalOcean App Platform sets PORT itself)
PORT=8000
GUNICORN_TIMEOUT=60

# --- Local proxy / ports ---------------------------------------------------------------
# Leave as "internal" to use Caddy's own certificate, or run `make certs` (mkcert) and set:
# CADDY_TLS=/certs/localhost.pem /certs/localhost-key.pem
CADDY_TLS=internal
HTTPS_PORT=443
HTTP_PORT=80
S3_PUBLIC_PORT=9443
MAILPIT_UI_PORT=8025

# --- Build -------------------------------------------------------------------------------
# Only needed on networks that inspect TLS: path to your organization's CA bundle.
# EXTRA_CA_FILE=C:/path/to/ca-bundle.pem

# --- Login security ------------------------------------------------------------------------
# Require every user to set up an authenticator app (TOTP) on first login.
MFA_REQUIRED=true
# Temporary lockout after failed logins: per IP, per account, within a time window.
ACCOUNT_LOGIN_FAILED_LIMIT=20/15m/ip,5/15m/key
# Use the client IP from the proxy's X-Forwarded-For header in the audit log.
AUDIT_TRUST_X_FORWARDED_FOR=true

# --- Application ---------------------------------------------------------------------------
# Public address used in referral links, QR codes and email links.
PUBLIC_BASE_URL=https://localhost
# Demo tools (Reset demo data). Never enable in production.
DEMO_MODE=true
# Extra image origin for the Content Security Policy when presigned URLs come from a
# different host than AWS_S3_PUBLIC_ENDPOINT_URL (e.g., in AWS: https://<bucket>.s3.<region>.amazonaws.com).
CSP_STORAGE_ORIGIN=
